#!/usr/bin/env python3
"""Copy-on-write clone of a directory tree: clone-tree <src> <dst>.

On APFS one clonefile(2) call clones the whole tree: seconds for a 1 GB
node_modules, no extra disk. Elsewhere it falls back to `cp -R --reflink=auto`
(btrfs, XFS) or `cp -Rc` (macOS off APFS), which share blocks per file.
"""
import ctypes
import ctypes.util
import subprocess
import sys

src, dst = sys.argv[1:3]
libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
if hasattr(libc, "clonefile"):
    libc.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
    if libc.clonefile(src.encode(), dst.encode(), 0) == 0:
        sys.exit(0)
    sys.exit(subprocess.call(["cp", "-Rc", src, dst]))
sys.exit(subprocess.call(["cp", "-R", "--reflink=auto", src, dst]))
